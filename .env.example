# ---------------------------------------------------------------------------
# Partiu DPM - variáveis de ambiente
# Copie este arquivo para .env.local e preencha com os dados do seu projeto.
# NUNCA versione o .env.local nem use a chave service_role no frontend.
# ---------------------------------------------------------------------------

# Project Settings > API > Project URL
NEXT_PUBLIC_SUPABASE_URL=

# Project Settings > API > Project API keys > anon public
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# URL pública do site (usada em metadados e links absolutos)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Somente servidor (nunca usar NEXT_PUBLIC_)
# ---------------------------------------------------------------------------

# Chave service_role: ignora a RLS. Usada pelo cron de convites e pelos e-mails
# que leem dados de outra pessoa (ex.: quem foi promovido da lista de espera).
SUPABASE_SERVICE_ROLE_KEY=

# Protege /api/cron/convites. A Vercel envia Authorization: Bearer <CRON_SECRET>.
CRON_SECRET=

# ---------------------------------------------------------------------------
# E-mails de inscrição (opcional; sem isso o envio é apenas ignorado)
# O remetente precisa ser verificado no provedor.
# ---------------------------------------------------------------------------
EMAIL_REMETENTE=
EMAIL_REMETENTE_NOME=Partiu DPM

# Brevo (tem prioridade)
BREVO_API_KEY=

# Alternativa: Resend
# RESEND_API_KEY=
